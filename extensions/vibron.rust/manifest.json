{
  "id": "vibron.rust",
  "name": "Rust",
  "version": "0.1.0",
  "category": "development",
  "contributes": {
    "languages": [
      {
        "id": "rust",
        "name": "Rust",
        "detect": {
          "extensions": [".rs"],
          "markers": ["Cargo.toml"]
        },
        "toolchain": {
          "command": "cargo",
          "versionArgs": ["--version"],
          "officialSite": "https://www.rust-lang.org/tools/install"
        },
        "testRunner": {
          "command": "cargo",
          "args": ["test", "--no-fail-fast"],
          "env": {
            "RUSTC_BOOTSTRAP": "1"
          },
          "report": {
            "format": "libtest-json",
            "source": "stdout",
            "args": ["--", "-Z", "unstable-options", "--format", "json", "--report-time"]
          },
          "filter": {
            "args": ["${filter}"]
          }
        },
        "recommend": {
          "on": ["file-open", "project-open"]
        }
      }
    ]
  }
}

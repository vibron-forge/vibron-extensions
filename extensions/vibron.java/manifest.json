{
  "id": "vibron.java",
  "name": "Java",
  "version": "0.1.0",
  "category": "development",
  "contributes": {
    "languages": [
      {
        "id": "java-maven",
        "name": "Java (Maven)",
        "detect": {
          "markers": ["pom.xml"]
        },
        "toolchain": {
          "command": "java",
          "versionArgs": ["-version"],
          "officialSite": "https://adoptium.net/"
        },
        "testRunner": {
          "command": "mvn",
          "args": ["test", "--batch-mode", "-Dmaven.ext.class.path=${extensionDir}/dist/maven/vibron-surefire-reports.jar"],
          "report": {
            "format": "junit-xml",
            "source": "directory",
            "args": ["-Dvibron.reportsDirectory=${reportDir}"]
          },
          "filter": {
            "args": ["-Dtest=${filter}"]
          }
        },
        "recommend": {
          "on": ["project-open"]
        }
      },
      {
        "id": "java-gradle",
        "name": "Java (Gradle)",
        "detect": {
          "markers": ["build.gradle", "build.gradle.kts", "settings.gradle", "settings.gradle.kts"]
        },
        "toolchain": {
          "command": "java",
          "versionArgs": ["-version"],
          "officialSite": "https://adoptium.net/"
        },
        "testRunner": {
          "command": "gradle",
          "args": ["test", "--init-script", "${extensionDir}/dist/gradle/vibron.init.gradle"],
          "report": {
            "format": "junit-xml",
            "source": "directory",
            "args": ["-Pvibron.reportsDirectory=${reportDir}"]
          },
          "filter": {
            "args": ["--tests", "${filter}"]
          }
        },
        "recommend": {
          "on": ["project-open"]
        }
      }
    ]
  }
}
